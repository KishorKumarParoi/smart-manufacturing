# ==============================================================================
# SMART MANUFACTURING MLOPS PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# General
APP_ENV=production
DEBUG=false
SERVICE_NAME=smart-manufacturing-inference-engine
LOG_LEVEL=INFO

# Cloud Provider Selection & Failover Roles
# AWS: Primary region (us-east-1) | GCP: Secondary failover (us-central1)
PRIMARY_CLOUD=aws
SECONDARY_CLOUD=gcp
AWS_REGION=us-east-1
AWS_CLUSTER_NAME=smart-mfg-eks-primary
GCP_REGION=us-central1
GCP_PROJECT_ID=smart-mfg-enterprise-prod
GCP_CLUSTER_NAME=smart-mfg-gke-failover

# Multi-Cloud Storage & Replication
AWS_S3_BUCKET_NAME=smart-mfg-mlops-artifacts-us-east-1
GCP_GCS_BUCKET_NAME=smart-mfg-mlops-artifacts-us-central1
CROSS_CLOUD_SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=300

# MLflow Tracking & Model Registry
MLFLOW_TRACKING_URI=http://mlflow.smartmfg.internal:5000
MLFLOW_EXPERIMENT_NAME=smart-manufacturing-defect-detection
MLFLOW_MODEL_NAME=industrial_defect_detector
MLFLOW_MODEL_STAGE=Production

# GPU & Inference Configuration
DEVICE=cuda
GPU_MEMORY_FRACTION=0.85
BATCH_SIZE=32
ANOMALY_THRESHOLD=0.68
CONFIDENCE_THRESHOLD=0.85

# Kubernetes & ArgoCD
KUBERNETES_NAMESPACE=smart-manufacturing
ARGOCD_SERVER=argocd.smartmfg.internal
ARGOCD_AUTH_TOKEN=change-me-in-production

# DNS & Global Failover
GLOBAL_DNS_DOMAIN=api.smartmfg.ai
AWS_HEALTH_CHECK_ID=hc-aws-us-east-1-primary
HEALTH_CHECK_INTERVAL_SECONDS=10
FAILOVER_UNHEALTHY_THRESHOLD=3
